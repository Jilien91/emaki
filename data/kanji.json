  "_comment": "Component breakdown for kanji appearing in the deck. Hand-authored. Component names are conventional radical meanings (grain, step, woman, child...) — deliberately NOT the invented names used by other courses, which are their own creative work. Where a decomposition is contested or unhelpful, 'note' is used instead of inventing parts.",

  "人": { "meaning": "person", "note": "A pictograph — a figure walking, seen from the side." },
  "日": { "meaning": "sun, day", "note": "A pictograph — the sun with a mark in the middle." },
  "生": { "meaning": "life, raw", "note": "A pictograph — a shoot pushing up out of the ground." },
  "白": { "meaning": "white", "note": "A pictograph — usually read as the sun just breaking the horizon." },
  "面": { "meaning": "face, surface", "note": "A pictograph — a face inside its outline." },
  "今": { "meaning": "now", "note": "A lid drawn shut over a single stroke — this moment, closed off from the rest." },
  "先": { "meaning": "ahead, previous", "note": "A figure striding out in front, on 儿 legs." },
  "無": { "meaning": "nothing, without", "note": "A thicket of strokes over 灬 fire — the lot of it burnt away to nothing." },
  "女": { "meaning": "woman", "note": "A pictograph — a figure kneeling, arms folded across." },
  "来": { "meaning": "come", "note": "Originally a wheat plant — the crop that comes to you at harvest." },
  "行": { "meaning": "go, conduct", "note": "A crossroads seen from above. Its left half is 彳, the step radical." },
  "前": { "meaning": "front, before", "note": "Horns over 月 moon over 刂 knife — the part that goes out in front." },
  "学": { "meaning": "study, learn", "note": "Sparks over a cover over 子 a child — a child under a roof, learning." },
  "帰": { "meaning": "return home", "note": "帚 a broom on the right — sweep up, then go back where you came from." },
  "一": { "meaning": "one", "note": "A single stroke. It doesn't get simpler than this." },
  "会": { "meaning": "meet", "note": "A roof with people gathering in underneath it." },
  "友": { "meaning": "friend", "note": "Two hand shapes reaching the same way." },
  "方": { "meaning": "direction, person (polite)", "note": "A pictograph of a plough or banner — a thing that points a way." },
  "昨": { "meaning": "previous", "note": "日 the sun with a marker beside it — the day just gone." },
  "番": { "meaning": "turn, number", "note": "釆 sorting laid over 田 a field — taking things in order." },
  "考": { "meaning": "consider", "note": "耂 an old man bent over, taking his time over it." },
  "言": { "meaning": "say, speech", "note": "A mouth with the sound drawn coming out of it." },
  "達": { "meaning": "reach, plural marker", "note": "辶 the road radical — getting there; on people it makes a group." },
  "高": { "meaning": "tall, expensive", "note": "A pictograph — a tall building, roof and gate stacked up." },
  "中": { "meaning": "inside, middle", "note": "A single line driven through the centre of a box." },
  "出": { "meaning": "exit, come out", "note": "Stacked peaks — something pushing up and out into view." },
  "大": { "meaning": "big", "note": "A person stood with both arms flung wide." },
  "当": { "meaning": "hit the mark, this", "note": "A simplified form — landing squarely on the right spot." },
  "母": { "meaning": "mother", "note": "A pictograph of a woman with the feeding marks drawn in." },
  "父": { "meaning": "father", "note": "A hand gripping an axe — the one who does the heavy work." },
  "立": { "meaning": "stand", "note": "A person planted on a line of ground, feet apart." },
  "入": { "meaning": "enter", "note": "A way in, drawn narrowing as it goes." },
  "声": { "meaning": "voice", "note": "A voice carrying — the older form had an ear listening to it." },
  "目": { "meaning": "eye", "note": "An eye stood on end, the lines of the lid across it." },
  "手": { "meaning": "hand", "note": "A hand with the fingers drawn out from the wrist." },
  "上": { "meaning": "up, above", "note": "A mark sitting above the line." },
  "元": { "meaning": "origin, base", "note": "Two strokes over 儿 legs — a person at their starting point." },
  "気": { "meaning": "spirit, energy", "note": "Steam rising off something — the old form had rice giving off vapour." },
  "丈": { "meaning": "length, height", "note": "A measure of a person's full height." },
  "夫": { "meaning": "husband, grown man", "note": "大 a person with a pin through the hair — an adult man." },
  "食": { "meaning": "eat, food", "note": "A lid sitting over a heaped dish." },
  "山": { "meaning": "mountain", "note": "Three peaks. One of the plainest pictographs there is." },
  "族": { "meaning": "clan, tribe", "note": "A banner with arrows beneath it — a family gathered under one flag." },
  "部": { "meaning": "section, part", "note": "阝 on the right marks a place or district — one section of it." },
  "事": { "meaning": "thing, matter", "note": "A hand gripping a banner — an affair being conducted, not an object." },
  "同": { "meaning": "same", "note": "A frame with everything tucked inside it, all under one cover." },
  "失": { "meaning": "lose", "note": "A hand with something slipping out of it." },
  "子": { "meaning": "child", "note": "A swaddled infant with its arms out, in three strokes." },
  "心": { "meaning": "heart", "note": "A pictograph of the organ itself, chambers and all." },
  "楽": { "meaning": "fun, music, ease", "note": "Strings stretched on a wooden frame — music, and the pleasure of it." },
  "様": { "meaning": "appearance, manner", "note": "The polite 様 of address, and the way a thing looks." },
  "申": { "meaning": "say humbly", "note": "Originally a bolt of lightning — a message sent upward." },
  "礼": { "meaning": "courtesy, bow", "note": "礻 an altar on the left, and the bow you make in front of it." },
  "自": { "meaning": "self", "note": "A nose. Japanese speakers point at their own nose to mean \"me\"." },

